<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-110dp"
        android:layout_marginEnd="-120dp"
        android:background="@drawable/bg_circle_decor" />

    <View
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-90dp"
        android:layout_marginBottom="-70dp"
        android:background="@drawable/bg_circle_decor" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="170dp"
            android:layout_height="170dp">

            <View
                android:id="@+id/splashRing"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_ring" />

            <ImageView
                android:id="@+id/splashLogo"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="@string/cd_logo"
                android:elevation="8dp"
                android:padding="24dp"
                android:src="@drawable/ic_logo_mark" />
        </FrameLayout>

        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_name"
            android:textColor="@color/lb_on_hero"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.01" />

        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/tagline"
            android:textColor="@color/lb_on_hero_muted"
            android:textSize="15sp" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/splashProgress"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp"
        android:indeterminate="true"
        app:indicatorColor="@color/white"
        app:trackColor="#40FFFFFF"
        app:trackCornerRadius="2dp"
        app:trackThickness="3dp" />
</FrameLayout>
