<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="36dp"
    android:paddingEnd="32dp"
    android:paddingBottom="36dp">

    <FrameLayout
        android:layout_width="104dp"
        android:layout_height="104dp">

        <View
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:alpha="0.45"
            android:background="@drawable/bg_circle_soft" />

        <ImageView
            android:id="@+id/emptyIcon"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_icon_tonal"
            android:importantForAccessibility="no"
            android:padding="19dp"
            android:src="@drawable/ic_inbox"
            android:tint="@color/lb_primary" />
    </FrameLayout>

    <TextView
        android:id="@+id/emptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.LB.Title" />

    <TextView
        android:id="@+id/emptyBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.LB.Caption" />
</LinearLayout>
