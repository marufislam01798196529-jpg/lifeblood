<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#090F1D" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="12dp">
            <ImageView android:layout_width="54dp" android:layout_height="54dp"
                android:src="@drawable/ic_audio_logo" android:contentDescription="Audio Studio Pro logo"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="AUDIO STUDIO PRO" android:textColor="#FFFFFF" android:textStyle="bold"
                    android:textSize="19sp" android:letterSpacing="0.04"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CREATE. EDIT. ENHANCE." android:textColor="#00D5C5"
                    android:textSize="10sp" android:letterSpacing="0.13" android:layout_marginTop="3dp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Your pocket audio workspace" android:textColor="#AAB8CC"
            android:textSize="14sp" android:layout_marginTop="24dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_card"
            android:layout_marginTop="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="AUDIO EDITOR" android:textColor="#00D5C5" android:textSize="11sp"
                android:textStyle="bold" android:letterSpacing="0.14"/>
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Choose an audio file to start editing." android:textColor="#FFFFFF"
                android:textSize="15sp" android:lineSpacingExtra="3dp" android:layout_marginTop="10dp"/>
            <Button android:id="@+id/importButton" android:layout_width="match_parent" android:layout_height="54dp"
                android:text="＋   Import audio" android:textAllCaps="false" android:textStyle="bold"
                android:textColor="#FFFFFF" android:background="@drawable/bg_primary_button"
                android:layout_marginTop="18dp"/>
            <Button android:id="@+id/playButton" android:layout_width="match_parent" android:layout_height="50dp"
                android:text="▶   Play selected audio" android:textAllCaps="false"
                android:textColor="#FFFFFF" android:backgroundTint="#263B59" android:layout_marginTop="8dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_card"
            android:layout_marginTop="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="PRECISION TRIM" android:textColor="#FFFFFF" android:textStyle="bold"
                android:textSize="16sp" android:letterSpacing="0.04"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Choose the section you want to keep. Times are measured in seconds."
                android:textColor="#AAB8CC" android:textSize="13sp" android:layout_marginTop="6dp"/>
            <EditText android:id="@+id/startSeconds" android:layout_width="match_parent" android:layout_height="52dp"
                android:hint="Start time · seconds" android:inputType="numberDecimal"
                android:textColor="#FFFFFF" android:textColorHint="#8292AA" android:backgroundTint="#398BFF"
                android:layout_marginTop="14dp"/>
            <EditText android:id="@+id/endSeconds" android:layout_width="match_parent" android:layout_height="52dp"
                android:hint="End time · seconds" android:inputType="numberDecimal"
                android:textColor="#FFFFFF" android:textColorHint="#8292AA" android:backgroundTint="#398BFF"
                android:layout_marginTop="6dp"/>
            <Button android:id="@+id/trimButton" android:layout_width="match_parent" android:layout_height="56dp"
                android:text="Trim and save M4A" android:textAllCaps="false" android:textStyle="bold"
                android:textColor="#FFFFFF" android:background="@drawable/bg_primary_button"
                android:layout_marginTop="14dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_card"
            android:layout_marginTop="16dp" android:layout_marginBottom="22dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="BUILT FOR LOW-END PHONES" android:textColor="#00D5C5"
                android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.08"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="• Processes compressed audio samples in small buffers\n• Does not decode the whole track into RAM\n• Uses Android file picker; no broad storage access\n• Exports directly to your chosen folder\n• Keeps the interface lightweight"
                android:textColor="#AAB8CC" android:textSize="13sp" android:lineSpacingExtra="5dp"
                android:layout_marginTop="10dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
